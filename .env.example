# Port for the local MCP server
PORT=3000

# Leave unset to use the in-memory state store (local dev / tests).
# Set to a DynamoDB table name (partition key: userId, type String) to persist state.
DDB_TABLE=

# Leave unset to use the built-in templated round recap.
# Set to an Amazon Bedrock model ID to write the spoken post-round recap with Bedrock.
BEDROCK_MODEL_ID=

# AWS region for DynamoDB / Bedrock
AWS_REGION=us-east-1
